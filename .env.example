# n8n 백엔드 (서버 전용 — NEXT_PUBLIC_ 접두어 절대 금지)
# 브라우저 번들에 노출되지 않도록 Route Handler 에서만 사용한다.

# n8n Webhook 베이스 URL (끝 슬래시 없이). 예: https://n8n.example.com
N8N_BASE_URL=

# n8n 요청 시 x-api-key 헤더로 부착할 토큰.
# Webhook 노드에 Header Auth 를 켰을 때만 필요 — 비어 있으면 헤더를 붙이지 않는다.
N8N_API_TOKEN=

# n8n Webhook 노드별 webhookId (UUID).
# 경로에 동적 값(:trial_id)이 있으면 n8n 이 webhookId 를 경로 앞에 강제로 붙이기 때문에
# 엔드포인트마다 서로 다른 UUID 가 필요하다. 값은 n8n 워크플로우 "[Trial API] - Main" 의
# 각 Webhook 노드 Production URL 에서 읽는다.
# 목록(GET /webhook/trials)은 동적 값이 없어 UUID 가 붙지 않으므로 변수도 없다.
N8N_WEBHOOK_ID_TRIAL_DETAIL=
N8N_WEBHOOK_ID_PRE_TRIAL_CALL_CHECK=
N8N_WEBHOOK_ID_NOTE=

# CloudTalk 클릭 발신(ct+tel:)의 발신자(from) 번호.
# 브라우저에서 링크를 생성하므로 NEXT_PUBLIC_ 필수. 비밀 아님(고객에게 보이는 발신 표시 번호).
# E.164 권장(공백/하이픈은 앱에서 정규화). 예: +82 234986970
NEXT_PUBLIC_CLOUDTALK_FROM=
