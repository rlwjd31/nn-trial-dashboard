# n8n 백엔드 (서버 전용 — NEXT_PUBLIC_ 접두어 절대 금지)
# 브라우저 번들에 노출되지 않도록 Route Handler 에서만 사용한다.

# n8n Webhook 베이스 URL (끝 슬래시 없이). 예: https://n8n.example.com
N8N_BASE_URL=

# n8n 요청 시 x-api-key 헤더로 부착할 토큰
N8N_API_TOKEN=

# CloudTalk 클릭 발신(ct+tel:)의 발신자(from) 번호.
# 브라우저에서 링크를 생성하므로 NEXT_PUBLIC_ 필수. 비밀 아님(고객에게 보이는 발신 표시 번호).
# E.164 권장(공백/하이픈은 앱에서 정규화). 예: +82 234986970
NEXT_PUBLIC_CLOUDTALK_FROM=
